   "steps": [
    {
     "show": "hero",
     "heading": "In 2000, solar was a rounding error.",
     "text": "The entire planet's solar panels produced <strong>1 terawatt-hour</strong> of electricity that year — about 0.007% of the world's power.",
     "state": {
      "value": {
       "data": "world",
       "where": {
        "year": 2000
       },
       "column": "solar"
      },
      "max": {
       "data": "world",
       "where": {
        "year": 2024
       },
       "column": "wind"
      },
      "label": "TWh of solar electricity, 2000",
      "from": 0
     }
    },
    {
     "show": "hero",
     "heading": "Then it grew two-thousand-fold.",
     "text": "By 2024 solar produced <strong>2,143 TWh</strong>. Nothing else in the energy system has ever scaled this fast.",
     "state": {
      "value": {
       "data": "world",
       "where": {
        "year": 2024
       },
       "column": "solar"
      },
      "max": {
       "data": "world",
       "where": {
        "year": 2024
       },
       "column": "wind"
      },
      "label": "TWh of solar electricity, 2024"
     }
    },
    {
     "show": "hero",
     "heading": "Wind did almost the same.",
     "text": "Wind went from 31 TWh to <strong>2,510 TWh</strong>. Together, solar and wind now supply <strong>15% of the world's electricity</strong>.",
     "state": {
      "value": {
       "data": "world",
       "where": {
        "year": 2024
       },
       "column": "wind"
      },
      "max": {
       "data": "world",
       "where": {
        "year": 2024
       },
       "column": "wind"
      },
      "label": "TWh of wind electricity, 2024",
      "sublabel": ""
     }
    },
    {
     "show": "mix",
     "heading": "Here is how the world made electricity in 2000…",
     "text": "Coal, gas and oil produced almost two-thirds of the world's 15,279 TWh.",
     "state": {
      "visible": [
       "coal",
       "gas",
       "oil"
      ]
     }
    },
    {
     "show": "mix",
     "heading": "…plus the old low-carbon workhorses.",
     "text": "Hydro and nuclear have been around for decades — and have barely grown since 2000.",
     "state": {
      "visible": [
       "coal",
       "gas",
       "oil",
       "nuclear",
       "other_renewable",
       "hydro"
      ]
     }
    },
    {
     "show": "mix",
     "heading": "And then solar and wind arrive.",
     "text": "Nearly invisible until 2010, they now form a fast-thickening layer on top of the world's power supply.",
     "state": {
      "highlight": [
       "wind",
       "solar"
      ]
     }
    },
    {
     "show": "mix",
     "heading": "Two milestones.",
     "text": "Solar + wind overtook <strong>nuclear in 2021</strong> and, for the first time ever, <strong>hydro in 2024</strong>.",
     "state": {
      "highlight": [
       "wind",
       "solar"
      ],
      "annotations": [
       {
        "x": 2021,
        "xRule": true,
        "text": "2021: solar + wind overtake nuclear",
        "anchor": "end",
        "level": 1
       },
       {
        "x": 2024,
        "xRule": true,
        "text": "2024: overtake hydro",
        "anchor": "end"
       }
      ]
     }
    },
    {
     "show": "mix",
     "heading": "But look at the shares.",
     "text": "Re-scale the same chart to 100% and the picture changes: fossil fuels still make <strong>59% of the world's electricity</strong>.",
     "state": {
      "normalize": true,
      "subtitle": "Share of generation by source, 2000–2024"
     }
    },
    {
     "show": "mix",
     "heading": "64.7% → 59.1%. That's it.",
     "text": "Twenty-four years of the fastest energy build-out in history moved fossil fuels' share of electricity down by less than six points. Coal generation is at an <strong>all-time high</strong>.",
     "state": {
      "normalize": true,
      "subtitle": "Share of generation by source, 2000–2024",
      "annotations": [
       {
        "stackTop": "oil",
        "x": 2000,
        "text": "Fossil {value}",
        "anchor": "start",
        "dy": -10
       },
       {
        "stackTop": "oil",
        "x": 2024,
        "text": "{value}",
        "anchor": "end",
        "dy": -10
       }
      ]
     }
    },
    {
     "show": "growth",
     "heading": "Why? Because demand doubled.",
     "text": "The world added 15,651 TWh since 2000 in three roughly equal chunks. Solar and wind <strong>matched</strong> coal's growth — they didn't <strong>replace</strong> it.",
